@page "/productos"
@using Tarea3.Models
@using Tarea3.Services
@inject IProductoService Servicio

<PageTitle>Productos</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="mb-0">Productos</h1>
    <a class="btn btn-primary" href="/productos/nuevo">Nuevo producto</a>
</div>

@if (error is not null)
{
    <p class="alert alert-danger" role="alert">@error</p>
}
else if (Mensaje is not null)
{
    <p class="alert alert-success" role="status">@Mensaje</p>
}

@if (pendiente is not null)
{
    <div class="alert alert-warning" role="dialog" aria-labelledby="confirmar-titulo" aria-describedby="confirmar-producto">
        <h2 id="confirmar-titulo" class="h5">Eliminar producto</h2>
        <p id="confirmar-producto">¿Eliminar «@pendiente.Nombre»?</p>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="CancelarEliminacion">Cancelar</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminacion">Confirmar eliminación</button>
        </div>
    </div>
}
<div class="mb-3">
    <label for="buscar" class="form-label">Buscar por nombre</label>
    <input id="buscar" type="search" disabled="@(!RendererInfo.IsInteractive)" class="form-control" @bind="busqueda" @bind:event="oninput" @bind:after="CargarProductos" />
</div>

@if (productos.Count == 0)
{
    <p role="status">@(string.IsNullOrWhiteSpace(busqueda) ? "No hay productos registrados." : "No se encontraron productos.")</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" class="text-end">Precio</th>
                    <th scope="col" class="text-end">Cantidad</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in productos)
                {
                    <tr @key="producto.Id">
                        <td>@producto.Id</td>
                        <th scope="row">@producto.Nombre</th>
                        <td>@producto.Descripcion</td>
                        <td class="text-end">@producto.Precio.ToString("N2")</td>
                        <td class="text-end">@producto.Cantidad</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="@($"/productos/{producto.Id}/editar")">Editar</a>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                    disabled="@(!RendererInfo.IsInteractive || pendiente is not null)"
                                    @onclick="() => SolicitarEliminacion(producto)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Producto> productos = [];
    private string busqueda = string.Empty;
    private Producto? pendiente;
    private string? mensaje;
    private string? error;

    [SupplyParameterFromQuery]
    private string? Resultado { get; set; }

    private string? Mensaje => mensaje ?? (Resultado switch
    {
        "creado" => "Producto registrado.",
        "actualizado" => "Producto actualizado.",
        _ => null
    });

    protected override void OnParametersSet()
    {
        CargarProductos();
    }

    private void SolicitarEliminacion(Producto producto)
    {
        mensaje = null;
        error = null;
        Resultado = null;
        pendiente = producto;
    }

    private void CancelarEliminacion()
    {
        pendiente = null;
    }

    private void ConfirmarEliminacion()
    {
        if (pendiente is null)
        {
            return;
        }

        int id = pendiente.Id;
        pendiente = null;

        if (Servicio.Eliminar(id))
        {
            mensaje = "Producto eliminado.";
        }
        else
        {
            error = "El producto no existe.";
        }

        CargarProductos();
    }

    private void CargarProductos()
    {
        productos = Servicio.Listar(busqueda);
    }
}
